{
  "name": "indexed",
  "description": "A flashcard MERN stack app",
  "version": "1.0.0",
  "main": "server/server.js",
  "engines": {
    "node": "26.x",
    "npm": "11.x"
  },
  "scripts": {
    "start": "node server/server.js",
    "client": "cd client && npm start",
    "dev": "concurrently --kill-others-on-fail \"cd server && npm run watch\" \"cd client && npm start\"",
    "build": "cd client && npm run build",
    "seed": "cd server && npm run seed",
    "heroku-postbuild": "npm --prefix client run build",
    "test": "jest",
    "postinstall": "npm --prefix server install && npm --prefix client install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bennygo3/IndexEd"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bennygo3/IndexEd/issues"
  },
  "type": "module",
  "devDependencies": {
    "concurrently": "8.2.2",
    "jest": "^29.7.0"
  },
  "private": true
}
